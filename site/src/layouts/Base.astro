---
// The single site shell.
//
// Design: "Ink Wash" — a grayscale editorial surface (see src/styles/global.css).
// The nav and footer are the only dark surfaces (#252525); everything between them
// is white, with #7D7D7D carrying every structural rule inside the prose.
//
// Fonts are self-hosted through @fontsource. Both families are SIL OFL 1.1 (verified
// against the google/fonts repo layout: ofl/crimsonpro, ofl/inter), so embedding is
// permitted; self-hosting means no third-party request and a deterministic build.
// Both ship as variable fonts. Two traps this import list exists to avoid:
//  1. `index.css` carries the NORMAL faces only, so the italic entry point is imported
//     separately — without it every blockquote would fall back to a synthesised oblique
//     rather than the family's drawn italic.
//  2. The variable packages declare the family as "<Name> Variable", so the CSS theme must
//     reference that exact name; asking for "Crimson Pro" matches no @font-face and every
//     glyph silently falls back to Georgia. See the --font-serif note in global.css.
import '../styles/global.css';
import '@fontsource-variable/inter/index.css';
import '@fontsource-variable/crimson-pro/index.css';
import '@fontsource-variable/crimson-pro/wght-italic.css';
import { UI, root, type Lang } from '../lib/i18n';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  // The language the page BODY is actually in. Payload serves English wherever a Spanish
  // translation does not exist yet, so a /es/ page can be Spanish chrome wrapped around
  // English prose. When that happens the body is marked with its real language and the
  // mismatch is stated — a page that declares <html lang="es"> over English text misleads
  // screen readers (which switch voice on it) and search engines alike.
  contentLang?: Lang;
}

const { title, description = '', lang = 'en', contentLang } = Astro.props;
const s = UI[lang];
const site = Astro.site ?? new URL('https://magnifica.agentesfidei.org');
const fellBack = contentLang !== undefined && contentLang !== lang;

// hreflang pair: strip a leading /es to get the English path, then re-add it for Spanish.
// Both links are emitted on every page, including where Spanish only has English text
// (Payload's fallback), which is what Q2 confirmed.
const here = Astro.url.pathname;
const withoutEs = here.replace(/^\/es/, '');
const enHref = new URL(withoutEs || '/', site).href;
const esHref = new URL(`/es${withoutEs || '/'}`, site).href;
const canonical = new URL(here, site).href;

const p = (path: string) => `${root(lang)}${path}`;

// Nav links share one treatment: #CFCFCF on the #252525 bar, lifting to the Vatican-yellow
// accent on hover (#FFE100 on #252525 is ~12.6:1, so the accent is legible exactly where it
// is used and nowhere it is not).
const navLink =
  'text-mist underline-offset-4 transition-colors duration-150 hover:text-vatican hover:underline';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="es" href={esHref} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={s.siteName}
      href={new URL('/rss.xml', site)}
    />
    <!-- Icons, generated from ops/brand/agentes-fidei-icon.png by scripts/build-favicons.mjs.
         The .ico carries 16/32/48; the PNG is declared for browsers that prefer it over the
         container. There is deliberately no SVG: the master is raster, so an SVG would be a
         trace, not the design. -->
    <link rel="icon" href={new URL('/favicon.ico', site)} sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href={new URL('/favicon-32.png', site)} sizes="32x32" />
    <link rel="apple-touch-icon" href={new URL('/apple-touch-icon.png', site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#252525" />
  </head>
  <body class="flex min-h-dvh flex-col bg-canvas font-sans text-ink">
    <!-- The 3px Vatican-yellow band above the dark bar is the flag reference: the one
         decorative use of the accent, and the only place it touches the white canvas. -->
    <header class="border-t-[3px] border-vatican bg-ink">
      <nav
        class="mx-auto flex max-w-measure flex-wrap items-baseline gap-x-5 gap-y-2 px-5 py-4 font-sans text-xs uppercase tracking-[0.1em] sm:px-6"
      >
        <a
          href={p('/')}
          class="w-full font-serif text-xl normal-case tracking-normal text-canvas no-underline sm:w-auto sm:mr-1"
        >
          {s.siteName}
        </a>
        <a href={p('/documents/')} class={navLink}>{s.documents}</a>
        <a href={p('/posts/')} class={navLink}>{s.essays}</a>
        <a href={p('/sources/')} class={navLink}>{s.sources}</a>
        <a
          href={lang === 'es' ? enHref : esHref}
          class={`ml-auto ${navLink}`}
          hreflang={s.switchHreflang}
        >
          {s.switchLabel}
        </a>
      </nav>
    </header>

    <main
      class="mx-auto w-full max-w-measure grow px-5 py-12 sm:px-6 sm:py-16"
      lang={fellBack ? contentLang : undefined}
    >
      {
        fellBack && (
          <p class="mb-10 border-l-2 border-slate bg-mist px-4 py-3 font-sans text-sm leading-relaxed text-meta">
            {s.fallbackNotice}
          </p>
        )
      }
      <slot />
    </main>

    <footer class="bg-ink">
      <div
        class="mx-auto max-w-measure px-5 py-8 font-sans text-xs leading-relaxed tracking-wide text-mist sm:px-6"
      >
        <p>{s.footerNote}</p>
      </div>
    </footer>
  </body>
</html>
