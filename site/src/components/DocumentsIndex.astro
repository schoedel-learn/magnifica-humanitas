---
import Base from '../layouts/Base.astro';
import { listPublishedDocuments } from '../lib/content';
import { UI, root, resolvedContentLang, type Lang } from '../lib/i18n';
import { formatDate } from '../lib/format';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const s = UI[lang];
const p = (path: string) => `${root(lang)}${path}`;
const documents = await listPublishedDocuments(lang);

const metaLabel = 'font-sans text-xs uppercase tracking-[0.1em] text-meta';
const itemTitle =
  'font-serif text-2xl leading-snug underline decoration-slate underline-offset-4 transition-colors hover:decoration-ink';
---

<Base
  title={`${s.documents} — ${s.siteName}`}
  description={s.tagline}
  lang={lang}
  contentLang={resolvedContentLang(lang, documents)}
>
  <h1>{s.documents}</h1>
  {
    documents.length === 0 ? (
      <p class="mt-6 text-meta">{s.noDocuments}</p>
    ) : (
      <ul class="mt-8 divide-y divide-slate">
        {documents.map((d) => (
          <li class="py-7 first:pt-0">
            <a href={p(`/documents/${d.slug}/`)} class={itemTitle}>
              {d.title ?? d.abbreviation}
            </a>
            <p class={`mt-2 ${metaLabel}`}>
              {d.abbreviation} · {d.doc_type}
              {d.published_date
                ? ` · ${s.publishedOn} ${formatDate(d.published_date, lang)}`
                : ''}
            </p>
            {d.summary && <p class="mt-3 leading-relaxed">{d.summary}</p>}
          </li>
        ))}
      </ul>
    )
  }
</Base>
