---
// Home page body, shared by / and /es/. The only difference between the two routes is
// `lang`: it selects the UI strings and the content locale passed to the query helpers.
import Base from '../layouts/Base.astro';
import { listPublishedDocuments, listPublishedPosts } from '../lib/content';
import { UI, itemLang, root, resolvedContentLang, type Lang } from '../lib/i18n';
import { formatDate } from '../lib/format';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const s = UI[lang];
const p = (path: string) => `${root(lang)}${path}`;

const [documents, posts] = await Promise.all([
  listPublishedDocuments(lang),
  listPublishedPosts(lang),
]);
const recent = posts.slice(0, 3);

const metaLabel = 'font-sans text-xs uppercase tracking-[0.1em] text-meta';
const itemTitle =
  'font-serif text-2xl leading-snug underline decoration-slate underline-offset-4 transition-colors hover:decoration-ink';
---

<Base
  title={s.siteName}
  description={s.tagline}
  lang={lang}
  contentLang={resolvedContentLang(lang, [...documents, ...posts])}
>
  <h1>{s.siteName}</h1>
  <p class="mt-4 max-w-[38rem] font-serif text-xl leading-relaxed text-meta">{s.tagline}</p>

  <section class="mt-12 border-t border-slate pt-8">
    <h2 class={`section-label ${metaLabel}`}>{s.corpus}</h2>
    {
      documents.length === 0 ? (
        <p class="mt-4 text-meta">{s.noDocuments}</p>
      ) : (
        <ul class="mt-5 divide-y divide-slate">
          {documents.map((d) => (
            <li class="py-6 first:pt-0" lang={itemLang(lang, d)}>
              <a href={p(`/documents/${d.slug}/`)} class={itemTitle}>
                {d.title ?? d.abbreviation}
              </a>
              <p class={`mt-2 ${metaLabel}`}>
                {d.abbreviation} · {d.doc_type}
                {d.published_date
                  ? ` · ${s.publishedOn} ${formatDate(d.published_date, lang)}`
                  : ''}
              </p>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <section class="mt-12 border-t border-slate pt-8">
    <h2 class={`section-label ${metaLabel}`}>{s.recentEssays}</h2>
    {
      recent.length === 0 ? (
        <p class="mt-4 text-meta">{s.noPosts}</p>
      ) : (
        <ul class="mt-5 divide-y divide-slate">
          {recent.map((post) => (
            <li class="py-6 first:pt-0" lang={itemLang(lang, post)}>
              <a href={p(`/posts/${post.slug}/`)} class={itemTitle}>
                {post.title ?? post.slug}
              </a>
              {post.abstract && <p class="mt-3 leading-relaxed text-meta">{post.abstract}</p>}
              <p class={`mt-3 ${metaLabel}`}>
                {post.published_at ? formatDate(post.published_at, lang) : s.undated}
              </p>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Base>
