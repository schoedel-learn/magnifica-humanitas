---
// Home page body, shared by / and /es/. The only difference between the two routes is
// `lang`: it selects the UI strings and the content locale passed to the query helpers.
import Base from '../layouts/Base.astro';
import { listPublishedPosts } from '../lib/content';
import { UI, itemLang, root, resolvedContentLang, type Lang } from '../lib/i18n';
import { formatDate } from '../lib/format';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const s = UI[lang];
const p = (path: string) => `${root(lang)}${path}`;

const posts = await listPublishedPosts(lang);
const recent = posts.slice(0, 3);

const metaLabel = 'font-sans text-xs uppercase tracking-[0.1em] text-meta';
const itemTitle =
  'font-serif text-2xl leading-snug underline decoration-slate underline-offset-4 transition-colors hover:decoration-ink';
---

<Base
  title={s.siteName}
  description={s.tagline}
  lang={lang}
  contentLang={resolvedContentLang(lang, posts)}
>
  <h1>{s.siteName}</h1>
  {/* The masthead credit: who publishes this. Tracked sans rather than the section-label
      treatment so it reads as a credit line under the title, not as the heading of a list. */}
  <p class="mt-3 font-sans text-[0.8125rem] uppercase tracking-[0.18em] text-meta">{s.publisher}</p>
  {/* Barry's motto, in the quote treatment the dictated lines already use on the Veritas page:
      mist panel, Vatican-yellow left rule, serif italic. It is a styled paragraph rather than a
      <blockquote> because nothing is being quoted — the element is for quoted material, and using
      it here would assert a source that does not exist.
      The panel is mist at 50%, not the solid fill the in-prose treatment uses: at full strength a
      grey slab directly under the title competed with the masthead instead of trailing it. */}
  <p
    class="mt-5 max-w-[34rem] border-l-[3px] border-vatican bg-mist/50 py-2 pl-4 pr-5 font-serif text-xl italic leading-snug"
  >
    {s.motto}
  </p>
  <p class="mt-6 max-w-[38rem] font-serif text-xl leading-relaxed text-meta">{s.tagline}</p>

  <section class="mt-12 border-t border-slate pt-8">
    <h2 class={`section-label ${metaLabel}`}>{s.recentPosts}</h2>
    {
      recent.length === 0 ? (
        <p class="mt-4 text-meta">{s.noPosts}</p>
      ) : (
        <ul class="mt-5 divide-y divide-slate">
          {recent.map((post) => (
            <li class="py-6 first:pt-0" lang={itemLang(lang, post)}>
              <a href={p(`/posts/${post.slug}/`)} class={itemTitle}>
                {post.title ?? post.slug}
              </a>
              {post.abstract && <p class="mt-3 leading-relaxed text-meta">{post.abstract}</p>}
              <p class={`mt-3 ${metaLabel}`}>
                {s.postTypes[post.post_type] ?? post.post_type}
                {post.published_at ? ` · ${formatDate(post.published_at, lang)}` : ` · ${s.undated}`}
              </p>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Base>
