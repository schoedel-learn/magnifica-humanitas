---
// The bibliography. Every work in `sources`, one entry each, grouped by KIND in a fixed reading
// order (magisterial → book → journal → …) rather than alphabetically across the whole list.
//
// This is a bibliography, not a works-cited page (Barry, 2026-10-18): a work qualifies by being
// in the list, so nothing is segregated for having no citation yet — seven of the eleven carry
// none today. Where a post cites a work, that is shown as an annotation under the entry ("Cited
// in …"); the per-paragraph locators stay on the post itself, beside the paragraph each one
// supports.
import Base from '../layouts/Base.astro';
import { listBibliography } from '../lib/content';
import { apaLocator, formatApa } from '../lib/citations';
import { renderEmphasis } from '../lib/emphasis';
import { selectedGroups, selectedStray } from '../lib/selected-groups';
import { UI, root, type Lang } from '../lib/i18n';
import { formatDate } from '../lib/format';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const s = UI[lang];
const p = (path: string) => `${root(lang)}${path}`;

const all = await listBibliography(lang);

const KIND_ORDER = [
  'magisterial',
  // `bible` sits where `book` did: Scripture is its own section now, so another translation can be
  // added without every non-scriptural book being filed under "Bibles".
  'bible',
  'book',
  'journal-article',
  'chapter',
  'web',
  'magazine',
  'thesis',
];
const groups = KIND_ORDER.map((kind) => ({
  kind,
  rows: all.filter((r) => r.kind === kind),
})).filter((g) => g.rows.length > 0);

// A `kind` absent from KIND_ORDER renders NOTHING at all, so anything unlisted is collected here
// rather than silently vanishing from the bibliography. It should stay empty; if it does not, the
// list is telling us a new enum value needs adding above.
const KNOWN = new Set(KIND_ORDER);
const stray = all.filter((r) => !KNOWN.has(r.kind));

const metaLabel = 'font-sans text-xs uppercase tracking-[0.1em] text-meta';
const citedLink =
  'underline decoration-slate underline-offset-4 transition-colors hover:decoration-ink';
---

<Base title={`${s.sources} — ${s.siteName}`} description={s.bibliographyHeading} lang={lang}>
  <h1>{s.bibliographyHeading}</h1>

  {/* The selected list leads: it is the curated entrance, the bibliography below is the
      audit trail. Both render through the same APA formatter; the entries live in a repo data
      file, not the database. */}
  <section id="selected">
    <h2 class={`section-label ${metaLabel}`}>{s.selectedPublicationsHeading}</h2>
    <p class="mt-6 font-serif text-lg leading-relaxed text-ink">
      <Fragment set:html={renderEmphasis(s.selectedPublicationsIntro)} />
    </p>
    <p class="mt-4 font-sans text-xs leading-relaxed text-meta">
      {s.selectedPublicationsNote}
    </p>
    {[...selectedGroups(lang), ...selectedStray()].map((group) => (
      <section class="mt-12 border-t border-slate pt-8">
        <h2 class={`section-label ${metaLabel}`}>
          {s.publicationKinds[group.kind] ?? group.kind}
        </h2>
        <ul class="mt-5 space-y-6 text-[0.9375rem]">
          {group.rows.map((row) => {
            const loc = apaLocator(row);
            return (
              <li class="leading-relaxed">
                <Fragment set:html={formatApa(row)} />
                {loc && (
                  <>
                    {' '}
                    <a class={citedLink} href={loc.href} rel="noopener">
                      {loc.label}
                    </a>
                  </>
                )}
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </section>

  {
    all.length === 0 ? (
      <p class="mt-6 text-meta">{s.noSources}</p>
    ) : (
      <>
        <section class="mt-12 border-t border-slate pt-8">
          <h2 class={`section-label ${metaLabel}`}>{s.bibliographyGroupLabel}</h2>
        </section>
        {[...groups, ...(stray.length ? [{ kind: 'other', rows: stray }] : [])].map((group) => (
        <section class="mt-12 border-t border-slate pt-8">
          <h2 class={`section-label ${metaLabel}`}>
            {s.sourceKinds[group.kind] ?? group.kind}
          </h2>
          <ul class="mt-5 space-y-6 text-[0.9375rem]">
            {group.rows.map((row) => {
              const loc = apaLocator(row);
              return (
                <li class="leading-relaxed">
                  <Fragment set:html={formatApa(row)} />
                  {loc && (
                    <>
                      {' '}
                      <a
                        class="underline decoration-slate underline-offset-4 break-words transition-colors hover:decoration-ink"
                        href={loc.href}
                        rel="noopener"
                      >
                        {loc.label}
                      </a>
                    </>
                  )}
                  {row.verified_on && (
                    <span
                      class={`ml-2 inline-block whitespace-nowrap border border-slate px-1.5 py-0.5 ${metaLabel}`}
                    >
                      {s.verified} {formatDate(row.verified_on, lang)}
                    </span>
                  )}
                  {row.citations.length > 0 && (
                    <p class={`mt-2 ${metaLabel}`}>
                      {s.citedIn}{' '}
                      {row.citations.map((c, i) => (
                        <>
                          {i > 0 && ' · '}
                          <a href={p(`/posts/${c.slug}/`)} class={citedLink}>
                            {c.title ?? c.slug}
                          </a>
                        </>
                      ))}
                    </p>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
        ))}
      </>
    )
  }
</Base>
