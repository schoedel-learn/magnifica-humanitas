---
import Base from '../layouts/Base.astro';
import { listSources } from '../lib/content';
import { apaLocator, formatApa } from '../lib/citations';
import { UI, type Lang } from '../lib/i18n';
import { formatDate } from '../lib/format';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const s = UI[lang];

const all = await listSources();

// Group by `kind` in a fixed, meaningful order rather than alphabetically so the
// bibliography reads magisterial → book → journal → … the way a reading list does.
const KIND_ORDER = [
  'magisterial',
  'book',
  'journal-article',
  'chapter',
  'web',
  'magazine',
  'thesis',
];
const groups = KIND_ORDER.map((kind) => ({
  kind,
  rows: all.filter((r) => r.kind === kind),
})).filter((g) => g.rows.length > 0);

const metaLabel = 'font-sans text-xs uppercase tracking-[0.1em] text-meta';
---

<Base title={`${s.sources} — ${s.siteName}`} description={s.bibliographyHeading} lang={lang}>
  <h1>{s.bibliographyHeading}</h1>
  {
    groups.length === 0 ? (
      <p class="mt-6 text-meta">{s.noSources}</p>
    ) : (
      groups.map((group) => (
        <section class="mt-12 border-t border-slate pt-8">
          <h2 class={`section-label ${metaLabel}`}>{group.kind}</h2>
          <ul class="mt-5 space-y-5 text-[0.9375rem]">
            {group.rows.map((row) => {
              const loc = apaLocator(row);
              return (
              <li class="leading-relaxed">
                <Fragment set:html={formatApa(row)} />
                {loc && (
                  <>
                    {' '}
                    <a
                      class="underline decoration-slate underline-offset-4 break-words transition-colors hover:decoration-ink"
                      href={loc.href}
                      rel="noopener"
                    >
                      {loc.label}
                    </a>
                  </>
                )}
                {row.verified_on && (
                  <span class={`ml-2 inline-block whitespace-nowrap border border-slate px-1.5 py-0.5 ${metaLabel}`}>
                    {s.verified} {formatDate(row.verified_on, lang)}
                  </span>
                )}
              </li>
              );
            })}
          </ul>
        </section>
      ))
    )
  }
</Base>
