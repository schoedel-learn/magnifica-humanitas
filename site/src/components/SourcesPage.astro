---
// The single source list. Grouped by the POST that cites each work (Barry, 2026-10-18: "a
// source list, topically organized") rather than by source kind: each section is the reading
// behind one piece, which is what a reader arriving from a post actually wants.
//
// Every work must appear somewhere. The post_sources table cannot express "this work is not
// cited yet", so a list built only from it would silently drop the New American Bible — the
// uncited tail below is the guard, and `listUncitedSources()` is a query rather than a
// subtraction for exactly that reason.
//
// A work cited by two posts appears under each. That is intended: the grouping is a reading
// list per post, not a catalogue of unique works.
import Base from '../layouts/Base.astro';
import { listWorksForPost, listUncitedSources, listPublishedPosts } from '../lib/content';
import { apaLocator, formatApa } from '../lib/citations';
import { UI, root, resolvedContentLang, type Lang } from '../lib/i18n';
import { formatDate } from '../lib/format';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const s = UI[lang];
const p = (path: string) => `${root(lang)}${path}`;

const posts = await listPublishedPosts(lang);
const groups = await Promise.all(
  posts.map(async (post) => ({ post, rows: await listWorksForPost(post.id) })),
);
const uncited = await listUncitedSources();

const metaLabel = 'font-sans text-xs uppercase tracking-[0.1em] text-meta';
const postLink =
  'font-serif text-xl underline decoration-slate underline-offset-4 transition-colors hover:decoration-ink';
---

<Base
  title={`${s.sources} — ${s.siteName}`}
  description={s.bibliographyHeading}
  lang={lang}
  contentLang={resolvedContentLang(lang, posts)}
>
  <h1>{s.bibliographyHeading}</h1>

  {
    groups.length === 0 && uncited.length === 0 ? (
      <p class="mt-6 text-meta">{s.noSources}</p>
    ) : (
      <>
        {groups.map(({ post, rows }) => (
          <section class="mt-12 border-t border-slate pt-8">
            <h2 class="font-serif text-2xl leading-snug">
              <a href={p(`/posts/${post.slug}/`)} class={postLink}>
                {post.title ?? post.slug}
              </a>
            </h2>
            <p class={`mt-2 ${metaLabel}`}>
              {s.postTypes[post.post_type] ?? post.post_type}
              {post.published_at ? ` · ${s.publishedOn} ${formatDate(post.published_at, lang)}` : ''}
            </p>
            {rows.length === 0 ? (
              <p class="mt-4 text-meta">{s.noSourcesForPost}</p>
            ) : (
              <ul class="mt-5 space-y-5 text-[0.9375rem]">
                {rows.map((row) => {
                  const loc = apaLocator(row);
                  return (
                    <li class="leading-relaxed">
                      <Fragment set:html={formatApa(row)} />
                      {loc && (
                        <>
                          {' '}
                          <a
                            class="underline decoration-slate underline-offset-4 break-words transition-colors hover:decoration-ink"
                            href={loc.href}
                            rel="noopener"
                          >
                            {loc.label}
                          </a>
                        </>
                      )}
                      {row.verified_on && (
                        <span class={`ml-2 inline-block whitespace-nowrap border border-slate px-1.5 py-0.5 ${metaLabel}`}>
                          {s.verified} {formatDate(row.verified_on, lang)}
                        </span>
                      )}
                    </li>
                  );
                })}
              </ul>
            )}
          </section>
        ))}

        {uncited.length > 0 && (
          <section class="mt-12 border-t border-slate pt-8">
            <h2 class={`section-label ${metaLabel}`}>{s.uncitedSources}</h2>
            <ul class="mt-5 space-y-5 text-[0.9375rem]">
              {uncited.map((row) => {
                const loc = apaLocator(row);
                return (
                  <li class="leading-relaxed">
                    <Fragment set:html={formatApa(row)} />
                    {loc && (
                      <>
                        {' '}
                        <a
                          class="underline decoration-slate underline-offset-4 break-words transition-colors hover:decoration-ink"
                          href={loc.href}
                          rel="noopener"
                        >
                          {loc.label}
                        </a>
                      </>
                    )}
                    {row.verified_on && (
                      <span class={`ml-2 inline-block whitespace-nowrap border border-slate px-1.5 py-0.5 ${metaLabel}`}>
                        {s.verified} {formatDate(row.verified_on, lang)}
                      </span>
                    )}
                  </li>
                );
              })}
            </ul>
          </section>
        )}
      </>
    )
  }
</Base>
