---
// Post body is Payload's Lexical rich text stored as jsonb (hand-off fact). It is converted
// with the official converter at the SAME Payload version (3.90.2) — never hand-parsed.
//
// Styling of the generated HTML lives in `.rich-text` (src/styles/global.css) rather than in
// a chain of arbitrary-variant utilities here, so the essay body has one source of truth.
import Base from '../layouts/Base.astro';
import { getPostBySlug, listSourcesForPost } from '../lib/content';
import { formatApa } from '../lib/citations';
import { UI, type Lang } from '../lib/i18n';
import { formatDate } from '../lib/format';
import { convertLexicalToHTML } from '@payloadcms/richtext-lexical/html';

interface Props {
  slug: string;
  lang?: Lang;
}
const { slug, lang = 'en' } = Astro.props;
const s = UI[lang];

const post = await getPostBySlug(slug, lang);
if (!post) throw new Error(`Post not found: ${slug}`);
const sources = await listSourcesForPost(post.id);

const bodyHtml = post.body
  ? convertLexicalToHTML({ data: post.body as never, disableContainer: true })
  : '';

const metaLabel = 'font-sans text-xs uppercase tracking-[0.1em] text-meta';
---

<Base
  title={`${post.title ?? post.slug} — ${s.siteName}`}
  description={post.abstract ?? ''}
  lang={lang}
>
  <article>
    <h1>{post.title ?? post.slug}</h1>

    <p class={`mt-3 ${metaLabel}`}>
      {post.post_type}
      {post.published_at ? ` · ${formatDate(post.published_at, lang)}` : ''}
    </p>

    {/* Standfirst — display register, matching the document pages. */}
    {post.abstract && (
      <p class="mt-8 border-b border-slate pb-8 font-serif text-xl leading-relaxed">
        {post.abstract}
      </p>
    )}

    {bodyHtml && <div class="rich-text mt-10" set:html={bodyHtml} />}

    {
      sources.length > 0 && (
        <section class="mt-16 border-t border-slate pt-6">
          <h2 class={metaLabel}>{s.sourcesForEssay}</h2>
          <ul class="mt-5 space-y-5 text-[0.9375rem]">
            {sources.map((row) => (
              <li>
                <p class={metaLabel}>{row.locator}</p>
                <p class="mt-1 leading-relaxed">
                  {row.doi || row.url ? (
                    <a
                      class="underline decoration-slate underline-offset-4 break-words transition-colors hover:decoration-ink"
                      href={row.doi ? `https://doi.org/${row.doi}` : row.url!}
                      rel="noopener"
                    >
                      {formatApa(row)}
                    </a>
                  ) : (
                    <span>{formatApa(row)}</span>
                  )}
                </p>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</Base>
