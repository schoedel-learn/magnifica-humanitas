---
import Base from '../layouts/Base.astro';
import { getDocumentBySlug, listParagraphs } from '../lib/content';
import { cite } from '../lib/citations';
import { renderEmphasis } from '../lib/emphasis';
import { UI, type Lang } from '../lib/i18n';
import { formatDate } from '../lib/format';

interface Props {
  slug: string;
  lang?: Lang;
}
const { slug, lang = 'en' } = Astro.props;
const s = UI[lang];

const doc = await getDocumentBySlug(slug, lang);
if (!doc) throw new Error(`Document not found: ${slug}`);
const paragraphs = await listParagraphs(doc.id, lang);

const metaLabel = 'font-sans text-xs uppercase tracking-[0.1em] text-meta';
---

<Base
  title={`${doc.title ?? doc.abbreviation} — ${s.siteName}`}
  description={doc.summary ?? ''}
  lang={lang}
>
  <article>
    <h1>{doc.title ?? doc.abbreviation}</h1>

    <p class={`mt-3 ${metaLabel}`}>
      {doc.abbreviation} · {doc.doc_type}
      {doc.published_date ? ` · ${s.publishedOn} ${formatDate(doc.published_date, lang)}` : ''}
    </p>

    <p class="mt-4 font-sans text-sm">
      {
        doc.vatican_url ? (
          <a
            class="underline decoration-slate underline-offset-4 transition-colors hover:decoration-ink"
            href={doc.vatican_url}
            rel="noopener"
          >
            {s.fullTextAtVatican}
          </a>
        ) : (
          <span class="text-meta">{s.sourceLinkPending}</span>
        )
      }
    </p>

    {/* Standfirst: a display element, so it takes the serif register rather than the
        body sans — the lede is part of the masthead, not of the argument. */}
    {doc.summary && (
      <p class="mt-8 border-b border-slate pb-8 font-serif text-xl leading-relaxed">
        {doc.summary}
      </p>
    )}

    <h2 class={`section-label mt-10 ${metaLabel}`}>{s.paragraphsHeading}</h2>

    <ol class="mt-4 divide-y divide-slate">
      {
        paragraphs.map((para) => (
          <li id={`p${para.number}`} class="scroll-mt-24 py-7 first:pt-4 last:pb-0">
            <p class={metaLabel}>{cite(doc.abbreviation, para.number)}</p>
            {para.extract && <blockquote class="mt-3" set:html={renderEmphasis(para.extract)} />}
            {para.note && <p class="mt-3 leading-relaxed">{para.note}</p>}
          </li>
        ))
      }
    </ol>
  </article>
</Base>
