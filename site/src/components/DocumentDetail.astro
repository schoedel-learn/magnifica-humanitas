---
import Base from '../layouts/Base.astro';
import { getDocumentBySlug, listParagraphs } from '../lib/content';
import { cite } from '../lib/citations';
import { renderEmphasis } from '../lib/emphasis';
import { UI, resolvedContentLang, type Lang } from '../lib/i18n';
import { formatDate } from '../lib/format';

interface Props {
  slug: string;
  lang?: Lang;
  // When this document is being shown AS a post (the quotations piece), the post's own title
  // is the page's H1 and the encyclical's title drops to a line beneath it. Without it the
  // document is the page and keeps its own title.
  title?: string;
  // The by-line and the author's affiliation, passed by the route that owns the post row. This
  // component has no post of its own — it renders a DOCUMENT, which is why they arrive from
  // outside.
  byline?: string;
  affiliation?: string;
}
const { slug, lang = 'en', title, byline, affiliation } = Astro.props;
const s = UI[lang];

const doc = await getDocumentBySlug(slug, lang);
if (!doc) throw new Error(`Document not found: ${slug}`);
const paragraphs = await listParagraphs(doc.id, lang);

const metaLabel = 'font-sans text-xs uppercase tracking-[0.1em] text-meta';
---

<Base
  title={`${title ?? doc.title ?? doc.abbreviation} — ${s.siteName}`}
  description={doc.summary ?? ''}
  lang={lang}
  contentLang={resolvedContentLang(lang, [doc])}
>
  <article>
    <h1>{title ?? doc.title ?? doc.abbreviation}</h1>

    {/* As a post, the work being quoted is named beneath the post's title: the encyclical is
        the source of every line below it, so it should not vanish from its own page. */}
    {title && (
      <p class="mt-3 font-serif text-lg leading-snug text-meta">{doc.title ?? doc.abbreviation}</p>
    )}

    {byline && <p class="mt-2 font-serif text-base italic text-meta">{byline}</p>}
    {affiliation && <p class="mt-0.5 font-serif text-sm italic text-meta">{affiliation}</p>}

    <p class={`mt-3 ${metaLabel}`}>
      {doc.abbreviation} · {doc.doc_type}
      {/* As a post, the document's own publication date is left out: the page would then carry
          two different "published" dates, and the one a reader takes as the post's would be the
          encyclical's. The standfirst states both of the document's dates in prose. */}
      {!title && doc.published_date
        ? ` · ${s.publishedOn} ${formatDate(doc.published_date, lang)}`
        : ''}
    </p>

    <p class="mt-4 font-sans text-sm">
      {
        doc.vatican_url ? (
          <a
            class="underline decoration-slate underline-offset-4 transition-colors hover:decoration-ink"
            href={doc.vatican_url}
            rel="noopener"
          >
            {s.fullTextAtVatican}
          </a>
        ) : (
          <span class="text-meta">{s.sourceLinkPending}</span>
        )
      }
    </p>

    {/* Standfirst: a display element, so it takes the serif register rather than the
        body sans — the lede is part of the masthead, not of the argument. */}
    {doc.summary && (
      <p class="mt-8 border-b border-slate pb-8 font-serif text-xl leading-relaxed">
        {doc.summary}
      </p>
    )}

    <h2 class={`section-label mt-10 ${metaLabel}`}>{s.paragraphsHeading}</h2>

    <ol class="mt-4 divide-y divide-slate">
      {
        paragraphs.map((para) => (
          <li id={`p${para.number}`} class="scroll-mt-24 py-7 first:pt-4 last:pb-0">
            <p class={metaLabel}>{cite(doc.abbreviation, para.number)}</p>
            {para.extract && <blockquote class="mt-3" set:html={renderEmphasis(para.extract)} />}
            {para.note && <p class="mt-3 leading-relaxed">{para.note}</p>}
          </li>
        ))
      }
    </ol>
  </article>
</Base>
