---
// The Veritas landing page — the bespoke "disciples of the truth" guide.
//
// Design decisions live in the plan this ships under (.hermes/plans/2026-10-15_151332-
// magnifica-truth-section.md): one long page, three anchored steps, guide copy hardcoded
// here (redeploy on the worker to change it — it is NOT a CMS global), the MH extracts
// rendered from doc_paragraphs so the CMS remains the only home of the quotations, and
// the Documents/Essays sections shared with every other topic page via TopicLists.
//
// Scripture: the EN page quotes the New American Bible Revised Edition verbatim (fetched
// from biblegateway.com 2026-10-15). The ES page quotes the *official Spanish edition of
// the encyclical* for MH extracts (the edition text, never a translation) but carries the
// Scripture references only: no official Spanish Catholic lectionary text is reachable for
// verification, and mislabeling another translation as the lectionary is worse than a
// pending note. The scriptureQuotesPending flag says so in the rendered page.
import Base from '../layouts/Base.astro';
import TopicLists from './TopicLists.astro';
import { getTopicBySlug, getDocumentBySlug, listParagraphsForTopic } from '../lib/content';
import { cite } from '../lib/citations';
import { renderEmphasis } from '../lib/emphasis';
import { UI, resolvedContentLang, root, type Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const s = UI[lang];
const p = (path: string) => `${root(lang)}${path}`;

// The topic row carries the name/description in the CMS; the guide copy around it is ours.
const topic = await getTopicBySlug('truth', lang);
if (!topic) throw new Error(`Topic not found in CMS: truth (lang=${lang})`);
const paragraphs = await listParagraphsForTopic(topic.id, lang);
const byNumber = new Map(paragraphs.map((row) => [row.number, row]));

const docSlug = 'magnifica-humanitas';
// The MH document is the one carrying these paragraphs; its page is where every citation
// label links (the same /documents/<slug>/#pNNN anchors the document page has). The
// abbreviation and slug come from the CMS row rather than constants, matching how
// DocumentDetail labels its paragraphs.
const doc = await getDocumentBySlug(docSlug, lang);
if (!doc) throw new Error(`Document not found in CMS: ${docSlug} (lang=${lang})`);
const citeLabel = (num: number) => cite(doc.abbreviation, num);

// Per-step data: `extracts` are the CMS paragraph numbers rendered from doc_paragraphs;
// everything else is the approved guide copy (plan answers 1-8, 2026-10-15).
interface StepCopy {
  name: string;
  aim: string;
  scripture: string[]; // rendered verbatim NAB-RE (EN) or reference-only (ES, pending)
  scriptureRefs: string[];
  cccRefs: string[]; // supporting frame citations only (plan answer 10)
  extracts: number[];
  guidance: string;
}

const metaLabel = 'font-sans text-xs uppercase tracking-[0.1em] text-meta';
const scripturePendingNote =
  lang === 'es'
    ? 'El texto de las citas bíblicas en castellano está pendiente de la revisión de Barry.'
    : 'Spanish lectionary wording for Scripture pending Barry’s review.';
const scripturePending = lang === 'es';

const en: StepCopy[] = [
  {
    name: 'Awakening',
    aim: 'See the truth about yourself: name and renounce self-deception, the lie each of us tells himself.',
    scripture: [
      '“If we say, ‘We are without sin,’ we deceive ourselves, and the truth is not in us. If we acknowledge our sins, he is faithful and just and will forgive our sins and cleanse us from every wrongdoing.”',
    ],
    scriptureRefs: ['1 Jn 1:8-9', 'cf. Ps 51:5-7'],
    cccRefs: [],
    extracts: [133],
    guidance:
      'Becoming a disciple of the truth begins with an admission, not an argument. Ask the Holy Spirit to show you one thing you have refused to know about yourself — a habit of mind, a flattering story, a small dishonesty you have made comfortable — and lay it before God in the sacrament of penance. The aim is integrity without duplicity: one honest self before God, the people you love, and the people you meet.',
  },
  {
    name: 'Commitment',
    aim: 'Once conversion begins, choose truth daily — in speech, records, promises and work — through repentance and fidelity in ordinary life.',
    scripture: [
      '“I am the way and the truth and the life.”',
      '“Let your ‘Yes’ mean ‘Yes,’ and your ‘No’ mean ‘No.’”',
    ],
    scriptureRefs: ['Jn 14:6', 'Mt 5:37'],
    cccRefs: ['Cf. CCC 2466-2470'],
    extracts: [137, 140],
    guidance:
      'Truth dwells in the small print of a day: what you say, what you record, what you promise and what you deliver. Make a nightly examen in truth — where did I bend the truth for comfort today? What did a tool or a platform lead me to assert without verifying? Whom do I owe a correction? Stay in relationship with Christ, who is the Truth, in prayer and the Eucharist: a life of honesty is sustained by him, not by willpower.',
  },
  {
    name: 'Sacrifice',
    aim: 'Renounce falsity at its costly points; the truth liberates and sends — witness begins in a life of integrity, then guides AI use, social media, communications and public commitments.',
    scripture: [
      '“If you remain in my word, you will truly be my disciples, and you will know the truth, and the truth will set you free.”',
    ],
    scriptureRefs: ['Jn 8:31-32'],
    cccRefs: ['Cf. CCC 2472'],
    extracts: [132, 138],
    guidance:
      'Liberation has a price: sometimes a correction of the record, sometimes a refusal to publish what flatters you, sometimes bearing the cost of an uncomfortable truth about yourself. Before you post, share or sign anything, apply the rule of Nehemiah: does this build the city or the tower? An agent of faith is expected to be countable for truth first in his personal life, and then in every use of AI, every social channel, and every public commitment.',
  },
];

// The Spanish page’s guide copy is a translation DRAFT awaiting Barry’s review per the
// site convention; its extracts are the official Spanish-edition text from the CMS. The
// Scripture quotations are deliberately absent (scripturePending) — see the header note.
const es: StepCopy[] = [
  {
    name: 'Despertar',
    aim: 'Ver la verdad sobre uno mismo: reconocer y renunciar al autoengaño, la mentira que cada uno se dice a sí mismo.',
    scripture: [],
    scriptureRefs: ['1 Jn 1, 8-9', 'cf. Sal 51, 5-7'],
    cccRefs: [],
    extracts: [133],
    guidance:
      'Ser discípulo de la verdad empieza con una admisión, no con un argumento. Pide al Espíritu Santo que te muestre una cosa que te hayas negado a saber de ti mismo —una costumbre, una historia que te halaga, una pequeña deshonestidad que ya te resulta cómoda— y ponla ante Dios en el sacramento de la penitencia. Se busca una integridad sin doblez: un solo yo veraz ante Dios y ante los demás.',
  },
  {
    name: 'Compromiso',
    aim: 'Empezada la conversión, elige la verdad cada día —en el hablar, los registros, las promesas y el trabajo— con arrepentimiento y fidelidad en lo ordinario.',
    scripture: [],
    scriptureRefs: ['Jn 14, 6', 'Mt 5, 37'],
    cccRefs: ['cf. CEC 2466-2470'],
    extracts: [137, 140],
    guidance:
      'La verdad vive en la letra pequeña de cada día: lo que dices, lo que registras, lo que prometes y lo que cumples. Haz un examen nocturno en la verdad: ¿dónde doblegué hoy la verdad por comodidad? ¿Qué me llevó una herramienta o una plataforma a afirmar sin verificar? ¿A quién debo una corrección? Permanece en relación con Cristo, que es la Verdad, en la oración y la Eucaristía: la vida de honestidad la sostiene él, no la sola fuerza de voluntad.',
  },
  {
    name: 'Sacrificio',
    aim: 'Renuncia a la falsedad en sus puntos costosos; la verdad liberta y envía: el testimonio empieza en una vida íntegra y guía después el uso de la IA, las redes, las comunicaciones y los compromisos públicos.',
    scripture: [],
    scriptureRefs: ['Jn 8, 31-32'],
    cccRefs: ['cf. CEC 2472'],
    extracts: [132, 138],
    guidance:
      'La liberación tiene precio: a veces corregir un registro, a veces no publicar lo que te halaga, a veces cargar con una verdad incómoda sobre ti mismo. Antes de publicar o firmar nada, aplica la regla de Nehemías: ¿esto construye la ciudad o la torre? El agente de la fe debe poder fiarse primero en su vida personal, y después en cada uso de la IA, en cada red y en cada compromiso público.',
  },
];

const steps: StepCopy[] = lang === 'es' ? es : en;

// Approved copy (plan, answers 6-8): epigraph, intro, meta descriptions.
const epigraph = {
  text:
    lang === 'es'
      ? '«No darás falso testimonio contra tu prójimo»' // ES wording pending official lectionary text — flagged below
      : '“You shall not bear false witness against your neighbor.”',
  ref: 'Ex 20:16',
};

// Barry's dictated copy for the opening section (2026-10-15), shipped with minimal,
// disclosed repairs — see the commit message for the before/after list. The Spanish is an
// agent translation DRAFT flagged for review (site convention), never his words.
const subtitle =
  lang === 'es'
    ? 'Camino triple para ser discípulos de la Verdad en una era de adicción'
    : 'Three-fold Path to be Disciples of Truth in an Age of Addiction';

const introParagraphs: string[] =
  lang === 'es'
    ? [
        'El octavo mandamiento contra el falso testimonio no es una lista ni un registro de una libertad humana que está prohibida. No es simplemente no hacer esta cosa (que, sin embargo, tenemos la libertad de hacer). Más bien, expresa cómo ejercer la libertad de modo que permanezcamos unidos a Dios y al prójimo. La mentira, el autoengaño, el engaño intencional de otros fractura nuestra relación con Dios y con el prójimo.',
        'A menudo, se hace en nombre de lo que parece una libertad: una comodidad deseada, una ganancia material, un cierto consuelo, un placer culpable. El autoengaño necesario para engañar a otros causa confusión y ceguera ante la voluntad de Dios. Cristo se convierte en un ideal lejano más que en un amigo íntimo. Llevamos este autoengaño al ámbito público, a menudo por ganancia personal, y podemos empezar a comerciar con él para nuestro propio avance.',
        'Pero, ¿quién es nuestro socio de intercambio? No es Dios. ¿Y qué hemos cambiado? Nuestro propio ser. Así nos perdemos: nuestra alma se pierde, la cambiamos por cosas que caducan, cosas que nos dejan peor, cosas que socavan nuestra paz, nuestra capacidad de amar, nuestra capacidad de verdadera alegría.',
        'Vivimos como adictos, adictos a los placeres temporales del mundo, haciendo eterno lo temporal. Cambiamos el infinito por lo momentáneo; el horizonte se reduce a un marco digital fijo de información.',
        'Nos deja agotados pero hambrientos, buscando todavía más estímulo temporal, sabiendo al mismo tiempo que este antojo es un pozo sin fondo, que no se puede llenar.',
        'Aun así intentamos llenarlo, no podemos soltarlo: podemos ir al porno, a la bebida, a la droga, a la intoxicación digital, una mezcla de todos. Empezó con una pequeña mentira sobre nosotros mismos: sacrificamos una verdad. ¿Podemos ver dónde empezamos? ¿Podemos ver cómo lo mantenemos cada día?',
        'En Magnifica Humanitas se nos recuerda que la verdad es un bien común (MH 131). Pero se pierde por completo como bien común sin el compromiso personal con la verdad, una vida de integridad viviendo el octavo mandamiento, especialmente en el contexto del mandamiento más grande: amar a Dios y al prójimo.',
        'El primer deber del discípulo no es público sino interior: la verdad del propio corazón, la libertad del autoengaño. Esto es esencial para la relación con Cristo, que es la Verdad.',
        'Esta guía revela un camino triple para llegar a ser, en cierto sentido, agentes de la verdad, un pueblo que puede dar testimonio de la verdad como bien común, que puede hacerla concreta, no como un ideal sofisticado sino como una experiencia vivida y compartida.',
      ]
    : [
        'The eighth commandment against false witness isn’t a list or record of a human freedom that is prohibited. It is not merely don’t do this thing (that you nonetheless have the freedom to do). Rather, it expresses how to exercise freedom in such a way that we remain united to God and our neighbor. Lying, self-deceit, intentional deception of others fractures our relationship with God and with our neighbor.',
        'Often, it is done in the name of what seems a freedom: a desired convenience, a material gain, a certain comfort, a guilty pleasure. The self-deceit required to deceive others causes confusion and blindness to God’s will. Christ becomes a distant ideal rather than an intimate friend. We carry this self-deception into the public sphere, often for personal gain, we may begin to trade in it for our own advancement.',
        'But, who is our trading partner? Not God. And what have we traded? Our very selves. Thus we lose ourselves, our soul is lost, we trade it for things that expire, things that leave us worse off, things that undermine our peace, our capacity to love, our capacity for true joy.',
        'We live like addicts, addicted to the temporary pleasures of the World, making the temporary into the eternal. We trade the infinite for the momentary, the horizon shrinks into a fixed digital framework of information.',
        'It leaves us spent, yet hungry, seeking even more temporary stimulation but at the same time knowing that this craving is a bottomless pit, it can’t be met.',
        'We still try to meet it, we can’t put it down, we may go to porn, to drink, to drug, to digital intoxication, a mix of all. It began with a small lie about ourselves, we sacrificed a truth. Can we see where we began? Can we see how we are maintaining it daily?',
        'In Magnifica Humanitas we are reminded that truth is a common good (MH 131). But it is lost completely as a common good without personal commitment to truth, a life of integrity in living the 8th commandment, especially in the context of the greatest commandment to love God and neighbor.',
        'The disciple’s first duty of truth is not public but interior: the truth of one’s own heart, freedom from self-deception. This is essential to relationship with Christ, who is the Truth.',
        'This guide reveals a three-fold path to becoming, in a sense, agents of the truth, a people who can bear witness to truth as a common good, who can make it concrete, not as a sophisticated ideal but a lived and shared experience.',
      ];

const metaDescription =
  lang === 'es'
    ? 'Guía en tres pasos para ser discípulo de la Verdad: despertar, compromiso, sacrificio. Primero la integridad de vida, luego el testimonio con la IA.'
    : 'A three-step Scriptural guide to becoming a disciple of the Truth: awakening, commitment, sacrifice — integrity first, then truthful witness with AI.';
---

<Base
  title={`${topic.name ?? s.veritas} — ${s.siteName}`}
  description={metaDescription}
  lang={lang}
  contentLang={resolvedContentLang(lang, [topic, ...paragraphs])}
>
  <article>
    <h1>{topic.name ?? s.veritas}</h1>
    <p class="mt-2 font-sans text-xs uppercase tracking-[0.1em] text-meta">
      Agentes Fidei ut Agentes Veritatis
    </p>
    <p class="mt-4 font-serif text-xl leading-relaxed text-meta">{subtitle}</p>

    <figure class="mt-10 border-b border-slate pb-10">
      <blockquote class="font-serif text-2xl italic">{epigraph.text}</blockquote>
      <figcaption class={`mt-3 ${metaLabel}`}>{epigraph.ref}</figcaption>
      {
        scripturePending && (
          <p class={`mt-3 text-meta ${metaLabel}`}>{scripturePendingNote}</p>
        )
      }
    </figure>

    {
      introParagraphs.map((para) => (
        <p
          class="mt-6 leading-relaxed first:mt-8"
          set:html={renderEmphasis(para).replace(
            'MH 131',
            `<a class="underline decoration-slate underline-offset-4 hover:decoration-ink" href="${p(`/documents/${doc.slug}/#p131`)}">MH 131</a>`,
          )}
        />
      ))
    }

    {
      steps.map((step, i) => {
        const n = i + 1;
        return (
          <section id={`step-${n}`} class="mt-14 scroll-mt-24 border-t border-slate pt-8">
            <h2 class={`section-label ${metaLabel}`}>
              {`${s.step} ${n}`} — {step.name}
            </h2>
            <p class="mt-4 font-serif text-xl italic leading-relaxed">{step.aim}</p>

            {step.scripture.map((quote) => (
              <blockquote class="mt-5 font-serif text-lg leading-relaxed">{quote}</blockquote>
            ))}
            {step.scriptureRefs.length > 0 && (
              <p class={`mt-3 ${metaLabel}`}>{step.scriptureRefs.join(' · ')}</p>
            )}
            {step.cccRefs.length > 0 && (
              <p class={`mt-1 ${metaLabel}`}>{step.cccRefs.join(' · ')}</p>
            )}
            {
              scripturePending && step.scripture.length === 0 && (
                <p class={`mt-3 text-meta ${metaLabel}`}>
                  Citas bíblicas en castellano pendientes de la aprobación de Barry.
                </p>
              )
            }

            {
              step.extracts.map((num) => {
                const row = byNumber.get(num);
                return (
                  <div class="mt-5">
                    <p class={`${metaLabel}`}>
                      <a
                        href={p(`/documents/${doc.slug}/#p${num}`)}
                        class="underline decoration-slate underline-offset-4 hover:decoration-ink"
                      >
                        {citeLabel(num)}
                      </a>
                    </p>
                    {row?.extract && (
                      <blockquote
                        class="mt-2 font-serif text-lg leading-relaxed"
                        set:html={renderEmphasis(row.extract)}
                      />
                    )}
                  </div>
                );
              })
            }

            <p class="mt-5 leading-relaxed">{step.guidance}</p>
          </section>
        );
      })
    }

    <TopicLists topicId={topic.id} lang={lang} />
  </article>
</Base>