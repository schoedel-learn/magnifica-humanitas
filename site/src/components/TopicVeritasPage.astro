---
// The Veritas landing page — the bespoke "disciples of the truth" guide.
//
// Design decisions live in the plan this ships under (.hermes/plans/2026-10-15_151332-
// magnifica-truth-section.md): one long page, three anchored steps, guide copy hardcoded
// here (redeploy on the worker to change it — it is NOT a CMS global), the MH extracts
// rendered from doc_paragraphs so the CMS remains the only home of the quotations, and
// the Documents/Essays sections shared with every other topic page via TopicLists.
//
// Scripture: the EN page quotes the New American Bible Revised Edition verbatim (fetched
// from biblegateway.com 2026-10-15). The ES page quotes the *official Spanish edition of
// the encyclical* for MH extracts (the edition text, never a translation) but carries the
// Scripture references only: no official Spanish Catholic lectionary text is reachable for
// verification, and mislabeling another translation as the lectionary is worse than a
// pending note. The scriptureQuotesPending flag says so in the rendered page.
import Base from '../layouts/Base.astro';
import TopicLists from './TopicLists.astro';
import { getTopicBySlug, getDocumentBySlug, listParagraphsForTopic } from '../lib/content';
import { cite } from '../lib/citations';
import { renderEmphasis } from '../lib/emphasis';
import { UI, resolvedContentLang, root, type Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const s = UI[lang];
const p = (path: string) => `${root(lang)}${path}`;

// The topic row carries the name/description in the CMS; the guide copy around it is ours.
const topic = await getTopicBySlug('truth', lang);
if (!topic) throw new Error(`Topic not found in CMS: truth (lang=${lang})`);
const paragraphs = await listParagraphsForTopic(topic.id, lang);
const byNumber = new Map(paragraphs.map((row) => [row.number, row]));

const docSlug = 'magnifica-humanitas';
// The MH document is the one carrying these paragraphs; its page is where every citation
// label links (the same /documents/<slug>/#pNNN anchors the document page has). The
// abbreviation and slug come from the CMS row rather than constants, matching how
// DocumentDetail labels its paragraphs.
const doc = await getDocumentBySlug(docSlug, lang);
if (!doc) throw new Error(`Document not found in CMS: ${docSlug} (lang=${lang})`);
const citeLabel = (num: number) => cite(doc.abbreviation, num);

// Per-step data: `extracts` are the CMS paragraph numbers rendered from doc_paragraphs;
// everything else is the approved guide copy (plan answers 1-8, 2026-10-15).
interface StepCopy {
  name: string;
  aim: string;
  scripture: string[]; // rendered verbatim NAB-RE (EN) or reference-only (ES, pending)
  scriptureRefs: string[];
  cccRefs: string[]; // supporting frame citations only (plan answer 10)
  extracts: number[];
  guidance: string;
}

const metaLabel = 'font-sans text-xs uppercase tracking-[0.1em] text-meta';
const scripturePendingNote =
  lang === 'es'
    ? 'El texto de las citas bíblicas en castellano está pendiente de la revisión de Barry.'
    : 'Spanish lectionary wording for Scripture pending Barry’s review.';
const scripturePending = lang === 'es';

const en: StepCopy[] = [
  {
    name: 'Awakening',
    aim: 'See the truth about yourself: name and renounce self-deception, the lie each of us tells himself.',
    scripture: [
      '“If we say, ‘We are without sin,’ we deceive ourselves, and the truth is not in us. If we acknowledge our sins, he is faithful and just and will forgive our sins and cleanse us from every wrongdoing.”',
    ],
    scriptureRefs: ['1 Jn 1:8-9', 'cf. Ps 51:5-7'],
    cccRefs: [],
    extracts: [133],
    guidance:
      'Becoming a disciple of the truth begins with an admission, not an argument. Ask the Holy Spirit to show you one thing you have refused to know about yourself — a habit of mind, a flattering story, a small dishonesty you have made comfortable — and lay it before God in the sacrament of penance. The aim is integrity without duplicity: one honest self before God, the people you love, and the people you meet.',
  },
  {
    name: 'Commitment',
    aim: 'Once conversion begins, choose truth daily — in speech, records, promises and work — through repentance and fidelity in ordinary life.',
    scripture: [
      '“I am the way and the truth and the life.”',
      '“Let your ‘Yes’ mean ‘Yes,’ and your ‘No’ mean ‘No.’”',
    ],
    scriptureRefs: ['Jn 14:6', 'Mt 5:37'],
    cccRefs: ['Cf. CCC 2466-2470'],
    extracts: [137, 140],
    guidance:
      'Truth dwells in the small print of a day: what you say, what you record, what you promise and what you deliver. Make a nightly examen in truth — where did I bend the truth for comfort today? What did a tool or a platform lead me to assert without verifying? Whom do I owe a correction? Stay in relationship with Christ, who is the Truth, in prayer and the Eucharist: a life of honesty is sustained by him, not by willpower.',
  },
  {
    name: 'Sacrifice',
    aim: 'Renounce falsity at its costly points; the truth liberates and sends — witness begins in a life of integrity, then guides AI use, social media, communications and public commitments.',
    scripture: [
      '“If you remain in my word, you will truly be my disciples, and you will know the truth, and the truth will set you free.”',
    ],
    scriptureRefs: ['Jn 8:31-32'],
    cccRefs: ['Cf. CCC 2472'],
    extracts: [132, 138],
    guidance:
      'Liberation has a price: sometimes a correction of the record, sometimes a refusal to publish what flatters you, sometimes bearing the cost of an uncomfortable truth about yourself. Before you post, share or sign anything, apply the rule of Nehemiah: does this build the city or the tower? An agent of faith is expected to be countable for truth first in his personal life, and then in every use of AI, every social channel, and every public commitment.',
  },
];

// The Spanish page’s guide copy is a translation DRAFT awaiting Barry’s review per the
// site convention; its extracts are the official Spanish-edition text from the CMS. The
// Scripture quotations are deliberately absent (scripturePending) — see the header note.
const es: StepCopy[] = [
  {
    name: 'Despertar',
    aim: 'Ver la verdad sobre uno mismo: reconocer y renunciar al autoengaño, la mentira que cada uno se dice a sí mismo.',
    scripture: [],
    scriptureRefs: ['1 Jn 1, 8-9', 'cf. Sal 51, 5-7'],
    cccRefs: [],
    extracts: [133],
    guidance:
      'Ser discípulo de la verdad empieza con una admisión, no con un argumento. Pide al Espíritu Santo que te muestre una cosa que te hayas negado a saber de ti mismo —una costumbre, una historia que te halaga, una pequeña deshonestidad que ya te resulta cómoda— y ponla ante Dios en el sacramento de la penitencia. Se busca una integridad sin doblez: un solo yo veraz ante Dios y ante los demás.',
  },
  {
    name: 'Compromiso',
    aim: 'Empezada la conversión, elige la verdad cada día —en el hablar, los registros, las promesas y el trabajo— con arrepentimiento y fidelidad en lo ordinario.',
    scripture: [],
    scriptureRefs: ['Jn 14, 6', 'Mt 5, 37'],
    cccRefs: ['cf. CEC 2466-2470'],
    extracts: [137, 140],
    guidance:
      'La verdad vive en la letra pequeña de cada día: lo que dices, lo que registras, lo que prometes y lo que cumples. Haz un examen nocturno en la verdad: ¿dónde doblegué hoy la verdad por comodidad? ¿Qué me llevó una herramienta o una plataforma a afirmar sin verificar? ¿A quién debo una corrección? Permanece en relación con Cristo, que es la Verdad, en la oración y la Eucaristía: la vida de honestidad la sostiene él, no la sola fuerza de voluntad.',
  },
  {
    name: 'Sacrificio',
    aim: 'Renuncia a la falsedad en sus puntos costosos; la verdad liberta y envía: el testimonio empieza en una vida íntegra y guía después el uso de la IA, las redes, las comunicaciones y los compromisos públicos.',
    scripture: [],
    scriptureRefs: ['Jn 8, 31-32'],
    cccRefs: ['cf. CEC 2472'],
    extracts: [132, 138],
    guidance:
      'La liberación tiene precio: a veces corregir un registro, a veces no publicar lo que te halaga, a veces cargar con una verdad incómoda sobre ti mismo. Antes de publicar o firmar nada, aplica la regla de Nehemías: ¿esto construye la ciudad o la torre? El agente de la fe debe poder fiarse primero en su vida personal, y después en cada uso de la IA, en cada red y en cada compromiso público.',
  },
];

const steps: StepCopy[] = lang === 'es' ? es : en;

// Barry's dictated copy for the opening section (2026-10-15; full rewrite dictated
// 2026-10-16), shipped with minimal, disclosed repairs — see the commit message for the
// before/after list. The Spanish is an agent translation DRAFT flagged for review (site
// convention), never his words.
//
// The subtitle he first dictated ("Three-fold Path to be Disciples of Truth in an Age of
// Addiction") was REPLACED 2026-10-16 by these two standfirst lines; the old wording stays
// in git history for revert.
const standfirstLines =
  lang === 'es'
    ? ['Agentes Fidei ut Agentes Veritatis', 'La verdad como bien común', 'Camino triple de discipulado en una cultura de las apariencias']
    : ['Agentes Fidei ut Agentes Veritatis', 'Truth as a common good', 'Three-fold Path of discipleship in a culture of appearances'];

// The dictated question sentences sit on their own lines in the display register (italic
// serif, mist ground, Vatican-yellow rule) — Barry: questions are an important aspect of
// how this guide works. The Ex 20:16 text moved INTO the flow (after his "8th Commandment
// is all about…" line) with the 2026-10-16 rewrite; it renders as the standard quote
// treatment. The tooltip on "our soul is lost" carries his dictated wording verbatim.
interface IntroBlock {
  kind: 'para' | 'question' | 'commandment';
  text: string;
  ref?: string;
}

const soulTooltip =
  lang === 'es'
    ? {
        phrase: 'nuestra alma se pierde',
        tip: '¿entendemos lo que significa perder el alma o nos hemos hecho cómodos con esta experiencia porque es todo lo que conocemos?',
      }
    : {
        phrase: 'our soul is lost',
        tip: 'do we understand what it means to lose the soul or have we become comfortable with this experience because it is all we know?',
      };

const soulTooltipHtml = (rendered: string) =>
  rendered.replace(
    `@@SOUL@@`,
    `<span class="group relative inline-block" tabindex="0">`
      + `<span class="cursor-help font-serif not-italic underline decoration-dotted decoration-slate decoration-2 underline-offset-4">${soulTooltip.phrase}</span>`
      + `<span role="tooltip" class="invisible group-focus-within:visible group-hover:visible absolute left-0 top-full z-10 mt-2 w-64 max-w-[80vw] bg-ink px-3 py-2 font-sans text-sm not-italic leading-snug text-canvas">${soulTooltip.tip}</span>`
      + `</span>`,
  );

const introBlocks: IntroBlock[] =
  lang === 'es'
    ? [
        { kind: 'para', text: 'Qué fácil es, en toda época, concentrarse en fabricar una apariencia. Hasta cierto punto esto es humano, y no hay nada malo en tener una persona pública y una privada. Sería errado lamentarse del hecho de que en nuestra propia época esto tenga otros medios y canales.' },
        { kind: 'para', text: 'Puede ser, además, un aspecto importante del arte: crear una apariencia para la impresión que evoca. Esto es parte de la cultura humana y puede usarse para custodiar la verdad en vez de oscurecerla.' },
        { kind: 'para', text: 'Lo más peligroso para la comunidad humana, y para la persona humana, es cuando la apariencia o el testimonio que creamos fractura la integridad personal y comunitaria, cuando el testimonio obra contra la verdad como bien personal y como bien común.' },
        { kind: 'para', text: 'Si la verdad nos hace libres, su contrario esclaviza a las personas y a la comunidad humana.' },
        { kind: 'para', text: 'De esto trata el octavo mandamiento…' },
        { kind: 'commandment', text: '«No darás falso testimonio contra tu prójimo»', ref: 'Ex 20:16' },
        { kind: 'para', text: 'El octavo mandamiento contra el falso testimonio no es una mera prohibición de la libertad humana de mentir. No es simplemente no hacer esta cosa (que, sin embargo, tenemos la libertad de hacer).' },
        { kind: 'para', text: 'Es más bien la propia autocomunicación de Dios sobre cómo vivir según su imagen y semejanza, para ser libres de la egoísta servidumbre del pecado y poder obrar con la libertad de amar. La mentira, el autoengaño, el engaño intencional de otros, fractura nuestra relación con Dios y con el prójimo. Nos des-integra a nosotros y a nuestra familia humana.' },
        { kind: 'para', text: 'El falso testimonio se ejerce a menudo en nombre de lo que parece una libertad: una comodidad deseada, una ganancia material, un cierto consuelo, un placer culpable, un ascenso, un avance.' },
        { kind: 'question', text: '¿Acaso no merecemos ese reconocimiento que podría distinguirnos?' },
        { kind: 'para', text: 'Lamentablemente, el autoengaño necesario para engañar a otros causa confusión y ceguera ante la voluntad de Dios, en ellos y en nosotros.' },
        { kind: 'para', text: 'El Verbo de Dios encarnado, la vida mesiánica de Cristo, se convierte en un ideal lejano de admiración en vez de una experiencia vivida de amor redentor. Cuando creamos falsas personas o nos contamos mentiras el tiempo suficiente para justificar los pecados que queremos conservar, llevamos este autoengaño al ámbito público. Esto agrava la confusión sobre quiénes somos y qué somos en vez de revelarlo. Y puede deshacerse amargamente con las revelaciones de portada de las verdaderas vidas de figuras públicas que creíamos conocer.' },
        { kind: 'question', text: '¿Cómo sería nuestra portada? ¿Sería mucho mejor?' },
        { kind: 'para', text: 'Cambiamos nuestra verdad, nuestra realidad, por algo vendible. Lucía bien; quizá trajo recompensas, pero estaba construido sobre arenas movedizas y no sobre la verdad, no sobre Cristo. Se edificaba sobre una esperanza, una ilusión de sí. Cambiamos la verdad por una apariencia que creímos necesaria.' },
        { kind: 'question', text: 'Pero, ¿quién es nuestro socio de intercambio? ¿Y qué hemos cambiado?' },
        { kind: 'para', text: 'Nuestro socio de intercambio: no Dios. Lo que hemos cambiado: nuestro propio ser.' },
        { kind: 'para', text: 'Así nos perdemos, @@SOUL@@, la cambiamos por cosas que caducan, cosas que nos dejan peor, cosas que socavan nuestra paz, nuestra capacidad de amar, nuestra capacidad de verdadera alegría.' },
        { kind: 'para', text: 'Vivir para lo temporal es vivir como adictos, porque lo temporal no puede saciar a seres de raíces eternas. Nos volvemos adictos a las afirmaciones y placeres temporales del mundo, haciendo eterno lo temporal. Cambiamos el infinito por lo momentáneo; el horizonte se reduce a un marco digital fijo de información. Vemos en cada nuevo movimiento, como la IA, la próxima cosa que podría salvarnos. La emoción es vertiginosa y distrae.' },
        { kind: 'para', text: 'Poner la búsqueda de lo eterno en lo temporal y finito nos deja agotados y hambrientos, buscando todavía más estímulo temporal, sabiendo al mismo tiempo que este antojo es un pozo sin fondo, que no se puede llenar. Cliqueamos, deslizamos, hojeamos.' },
        { kind: 'question', text: '¿Dónde está? ¿Qué es? Sé que busco algo más profundo, pero ¿qué?' },
        { kind: 'para', text: 'Aun así intentamos llenarlo, no podemos soltarlo: podemos ir a la política, al odio, al porno, a la bebida, a la droga, a más intoxicación digital, una mezcla de todos. Empezó con una pequeña mentira sobre nosotros mismos: sacrificamos una verdad. Empezó con un pecado contra el octavo mandamiento.' },
        { kind: 'question', text: '¿Podemos ver dónde empezamos? ¿Podemos ver cómo lo mantenemos cada día?' },
        { kind: 'para', text: 'En *Magnifica Humanitas* se nos recuerda que la verdad es un bien común (MH 131). Pero se pierde por completo como bien común sin el compromiso personal con la verdad, una vida de integridad viviendo el octavo mandamiento, especialmente en el contexto del mandamiento más grande: amar a Dios y al prójimo.' },
        { kind: 'para', text: 'El primer deber del discípulo no es público sino interior: la verdad del propio corazón, la libertad del autoengaño. Esto es esencial para la relación con Cristo, que es la Verdad.' },
        { kind: 'para', text: 'Esta guía revela un camino triple para llegar a ser, en cierto sentido, agentes de la verdad, un pueblo que puede dar testimonio de la verdad como bien común, que puede hacerla concreta, no como un ideal sofisticado sino como una experiencia vivida y compartida.' },
      ]
    : [
        { kind: 'para', text: 'How easy it is in every age to focus on crafting an appearance. To a certain extent this is human, and there is nothing wrong with having a public and a private persona. It would be wrong to wail against the fact that in our own age this has different means and media.' },
        { kind: 'para', text: 'It can also be an important aspect of art, to create an appearance for the purpose of the impression it evokes. This is part of human culture and can be used to steward truth rather than obscure it.' },
        { kind: 'para', text: 'What is more dangerous to the human community, and to the human person, is when the appearance or witness we create is fractious of personal and communal integrity, when witness works against truth as a personal and as a common good.' },
        { kind: 'para', text: 'If truth sets us free its opposite enslaves human persons and the human community.' },
        { kind: 'para', text: 'This is what the 8th Commandment is all about…' },
        { kind: 'commandment', text: '“You shall not bear false witness against your neighbor.”', ref: 'Ex 20:16' },
        { kind: 'para', text: 'The eighth commandment against false witness isn’t a mere prohibition against the human freedom to lie. It is not merely don’t do this thing (that you nonetheless have the freedom to do).' },
        { kind: 'para', text: 'Rather, it is God’s own self-communication about how to live in his image and likeness, to be free rather from the selfishness of sin and to be able to act with the freedom to love. Lying, self-deceit, intentional deception of others, fractures our relationship with God and with our neighbor. It dis-integrates us and our human family.' },
        { kind: 'para', text: 'False witness is often exercised in the name of what seems a freedom: a desired convenience, a material gain, a certain comfort, a guilty pleasure, a promotion, an advancement.' },
        { kind: 'question', text: 'After all don’t we deserve that recognition that might set us apart?' },
        { kind: 'para', text: 'Unfortunately, the self-deceit required to deceive others causes confusion and blindness to God’s will, for them and for us.' },
        { kind: 'para', text: 'The Word of God Incarnate, the Messianic life of Christ, becomes a distant ideal of admiration rather than a lived experience of redemptive love. When we create false personas or tell ourselves lies long enough to justify sins we want to hold onto we carry this self-deception into the public sphere. This compounds confusion about who and what we are rather than reveals it. This can be bitterly broken by front page revelations of the true lives of public figures we thought we knew.' },
        { kind: 'question', text: 'What would our front page look like? Would it be so much better?' },
        { kind: 'para', text: 'We traded our truth, our reality, for something that was sell-able. It looked great, it may have brought rewards, but it was built upon shifting sands rather than truth, rather than Christ. It was built upon a hope, an illusion of self. We traded the truth for an appearance we thought necessary.' },
        { kind: 'question', text: 'But, who is our trading partner? And what have we traded?' },
        { kind: 'para', text: 'Our trading partner: not God. What we have traded: our very selves.' },
        { kind: 'para', text: 'Thus we lose ourselves, @@SOUL@@, we trade it for things that expire, things that leave us worse off, things that undermine our peace, our capacity to love, our capacity for true joy.' },
        { kind: 'para', text: 'To live for the temporal is to live as addicts because the temporal can’t satisfy beings with eternal roots. We become addicted to the temporary affirmations and pleasures of the World, making the temporary into the eternal. We trade the infinite for the momentary, the horizon shrinks into a fixed digital framework of information. We see every new movement like AI as the next thing that might save us. The excitement is dizzying and distracting.' },
        { kind: 'para', text: 'Putting the pursuit of the eternal in the temporary and finite leaves us spent, hungry, seeking even more temporary stimulation but at the same time knowing that this craving is a bottomless pit, it can’t be met. We click, we swipe, we scroll.' },
        { kind: 'question', text: 'Where is it? What is it? I know I am seeking something deeper, but what?' },
        { kind: 'para', text: 'We still try to meet it, we can’t put it down, we may go to politics, to hatred, to porn, to drink, to drug, to more digital intoxication, a mix of all. It began with a small lie about ourselves, we sacrificed a truth. It started with a sin against the 8th commandment.' },
        { kind: 'question', text: 'Can we see where we began? Can we see how we are maintaining it daily?' },
        { kind: 'para', text: 'In *Magnifica Humanitas* we are reminded that truth is a common good (MH 131). But it is lost completely as a common good without personal commitment to truth, a life of integrity in living the 8th commandment, especially in the context of the greatest commandment to love God and neighbor.' },
        { kind: 'para', text: 'The disciple’s first duty of truth is not public but interior: the truth of one’s own heart, freedom from self-deception. This is essential to relationship with Christ, who is the Truth.' },
        { kind: 'para', text: 'This guide reveals a three-fold path to becoming, in a sense, agents of the truth, a people who can bear witness to truth as a common good, who can make it concrete, not as a sophisticated ideal but a lived and shared experience.' },
      ];

const metaDescription =
  lang === 'es'
    ? 'Guía en tres pasos para ser discípulo de la Verdad: despertar, compromiso, sacrificio. Primero la integridad de vida, luego el testimonio con la IA.'
    : 'A three-step Scriptural guide to becoming a disciple of the Truth: awakening, commitment, sacrifice — integrity first, then truthful witness with AI.';

---

<Base
  title={`${topic.name ?? s.veritas} — ${s.siteName}`}
  description={metaDescription}
  lang={lang}
  contentLang={resolvedContentLang(lang, [topic, ...paragraphs])}
>
  <article>
    <h1>{topic.name ?? 'Agentes Veritatis'}</h1>
    <div class="mt-2 space-y-1">
      {standfirstLines.map((line) => (
        <p class="font-sans text-xs uppercase tracking-[0.1em] text-meta">{line}</p>
      ))}
      {
        scripturePending && (
          <p class={`pt-1 text-meta ${metaLabel}`}>{scripturePendingNote}</p>
        )
      }
    </div>

    {
      introBlocks.map((block, i) => {
        const mhLink = (html: string) =>
          html.replace(
            'MH 131',
            `<a class="underline decoration-slate underline-offset-4 hover:decoration-ink" href="${p(`/documents/${doc.slug}/#p131`)}">MH 131</a>`,
          );
        if (block.kind === 'question') {
          return (
            <p
              class="mt-8 border-l-[3px] border-vatican bg-mist pl-4 pr-5 py-2.5 font-serif text-2xl italic leading-snug"
              set:html={renderEmphasis(block.text)}
            />
          );
        }
        if (block.kind === 'commandment') {
          // The 8th-Commandment text, now IN the flow (it moved with the 2026-10-16
          // rewrite). A bare blockquote picks up the site-wide quote treatment
          // (mist ground, slate rule) — the question lines above/below are the yellow
          // accents; the commandment is a quotation, so it stays in the quote family.
          return (
            <figure class="mt-8">
              <blockquote class="font-serif text-2xl italic" set:html={renderEmphasis(block.text)} />
              <figcaption class={`mt-2 text-right ${metaLabel}`}>{block.ref}</figcaption>
            </figure>
          );
        }
        return (
          <p
            class={`leading-relaxed ${i === 0 ? 'mt-8' : 'mt-6'}`}
            set:html={soulTooltipHtml(mhLink(renderEmphasis(block.text)))}
          />
        );
      })
    }

    {
      steps.map((step, i) => {
        const n = i + 1;
        return (
          <section id={`step-${n}`} class="mt-14 scroll-mt-24 border-t border-slate pt-8">
            <h2
              class={`section-label font-sans text-base uppercase tracking-[0.1em] text-meta`}
            >
              {`${s.step} ${n}`} — {step.name}
            </h2>
            <p class="mt-4 font-serif text-2xl italic leading-relaxed">{step.aim}</p>

            {step.scripture.map((quote) => (
              <blockquote class="mt-5 font-serif text-lg leading-relaxed">{quote}</blockquote>
            ))}
            {step.scriptureRefs.length > 0 && (
              <p class={`mt-3 ${metaLabel}`}>{step.scriptureRefs.join(' · ')}</p>
            )}
            {step.cccRefs.length > 0 && (
              <p class={`mt-1 ${metaLabel}`}>{step.cccRefs.join(' · ')}</p>
            )}
            {
              scripturePending && step.scripture.length === 0 && (
                <p class={`mt-3 text-meta ${metaLabel}`}>
                  Citas bíblicas en castellano pendientes de la aprobación de Barry.
                </p>
              )
            }

            {
              step.extracts.map((num) => {
                const row = byNumber.get(num);
                return (
                  <div class="mt-5">
                    <p class={`${metaLabel}`}>
                      <a
                        href={p(`/documents/${doc.slug}/#p${num}`)}
                        class="underline decoration-slate underline-offset-4 hover:decoration-ink"
                      >
                        {citeLabel(num)}
                      </a>
                    </p>
                    {row?.extract && (
                      <blockquote
                        class="mt-2 font-serif text-lg leading-relaxed"
                        set:html={renderEmphasis(row.extract)}
                      />
                    )}
                  </div>
                );
              })
            }

            <p class="mt-5 leading-relaxed">{step.guidance}</p>
          </section>
        );
      })
    }

    <TopicLists topicId={topic.id} lang={lang} />
  </article>
</Base>