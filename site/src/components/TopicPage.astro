---
import Base from '../layouts/Base.astro';
import TopicLists from './TopicLists.astro';
import { getTopicBySlug } from '../lib/content';
import { UI, resolvedContentLang, type Lang } from '../lib/i18n';

interface Props {
  slug: string;
  lang?: Lang;
}
const { slug, lang = 'en' } = Astro.props;
const s = UI[lang];

const topic = await getTopicBySlug(slug, lang);
if (!topic) throw new Error(`Topic not found: ${slug}`);
---

<Base
  title={`${topic.name ?? topic.slug} — ${s.siteName}`}
  description={topic.description ?? ''}
  lang={lang}
  contentLang={resolvedContentLang(lang, [topic])}
>
  <h1>{topic.name ?? topic.slug}</h1>
  {topic.description && (
    <p class="mt-4 font-serif text-xl leading-relaxed text-meta">{topic.description}</p>
  )}

  <TopicLists topicId={topic.id} lang={lang} />
</Base>