---
import Base from '../layouts/Base.astro';
import { getTopicBySlug, listDocumentsForTopic, listPostsForTopic } from '../lib/content';
import { UI, itemLang, root, resolvedContentLang, type Lang } from '../lib/i18n';
import { formatDate } from '../lib/format';

interface Props {
  slug: string;
  lang?: Lang;
}
const { slug, lang = 'en' } = Astro.props;
const s = UI[lang];
const p = (path: string) => `${root(lang)}${path}`;

const topic = await getTopicBySlug(slug, lang);
if (!topic) throw new Error(`Topic not found: ${slug}`);
const [posts, documents] = await Promise.all([
  listPostsForTopic(topic.id, lang),
  listDocumentsForTopic(topic.id, lang),
]);

const metaLabel = 'font-sans text-xs uppercase tracking-[0.1em] text-meta';
const itemLink =
  'font-serif text-lg underline decoration-slate underline-offset-4 transition-colors hover:decoration-ink';
---

<Base
  title={`${topic.name ?? topic.slug} — ${s.siteName}`}
  description={topic.description ?? ''}
  lang={lang}
  contentLang={resolvedContentLang(lang, [topic])}
>
  <h1>{topic.name ?? topic.slug}</h1>
  {topic.description && (
    <p class="mt-4 font-serif text-xl leading-relaxed text-meta">{topic.description}</p>
  )}

  <section class="mt-12 border-t border-slate pt-8">
    <h2 class={`section-label ${metaLabel}`}>{s.documents}</h2>
    {
      documents.length === 0 ? (
        <p class="mt-4 text-meta">{s.noDocuments}</p>
      ) : (
        <ul class="mt-5 divide-y divide-slate">
          {documents.map((d) => (
            <li class="py-4 first:pt-0" lang={itemLang(lang, d)}>
              <a href={p(`/documents/${d.slug}/`)} class={itemLink}>
                {d.title ?? d.abbreviation}
              </a>
              <span class={`ml-2 ${metaLabel}`}>{d.abbreviation}</span>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <section class="mt-12 border-t border-slate pt-8">
    <h2 class={`section-label ${metaLabel}`}>{s.essays}</h2>
    {
      posts.length === 0 ? (
        <p class="mt-4 text-meta">{s.noPosts}</p>
      ) : (
        <ul class="mt-5 divide-y divide-slate">
          {posts.map((post) => (
            <li class="py-4 first:pt-0" lang={itemLang(lang, post)}>
              <a href={p(`/posts/${post.slug}/`)} class={itemLink}>
                {post.title ?? post.slug}
              </a>
              <span class={`ml-2 ${metaLabel}`}>
                {post.published_at ? formatDate(post.published_at, lang) : s.undated}
              </span>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Base>
