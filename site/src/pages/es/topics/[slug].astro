---
import TopicPage from '../../../components/TopicPage.astro';
import TopicVeritasPage from '../../../components/TopicVeritasPage.astro';
import { listTopics } from '../../../lib/content';

// The Veritas topic is the one topic with a localized URL slug: the CMS row is `truth`
// (slugs are not localized), but the Spanish route is /es/topics/verdad/ per the plan.
// The mapping is expressed HERE, once, so both the static path and the render branch see it.
export async function getStaticPaths() {
  const topics = await listTopics('es');
  return topics.map((t) => ({
    params: { slug: t.slug === 'truth' ? 'verdad' : t.slug },
    props: { slug: t.slug },
  }));
}

const { slug } = Astro.props;
---

{slug === 'truth' ? <TopicVeritasPage lang="es" /> : <TopicPage slug={slug} lang="es" />}