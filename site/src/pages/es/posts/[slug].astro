---
// The Spanish posts route — same bespoke renderers as the English one (see ../../posts/[slug]).
// The guide and the extracts are hardcoded-copy pages that carry their own `lang` handling.
import PostDetail from '../../../components/PostDetail.astro';
import TopicVeritasPage from '../../../components/TopicVeritasPage.astro';
import DocumentDetail from '../../../components/DocumentDetail.astro';
import { getPostBySlug, listPublishedPosts } from '../../../lib/content';

const BESPOKE: Record<string, 'veritas' | 'extracts'> = {
  'agentes-veritatis': 'veritas',
  'magnifica-humanitas-in-quotations': 'extracts',
};
const EXTRACTS_DOCUMENT = 'magnifica-humanitas';

export async function getStaticPaths() {
  const posts = await listPublishedPosts('es');
  return posts.map((p) => ({ params: { slug: p.slug }, props: { slug: p.slug } }));
}

const { slug } = Astro.props;
const kind = BESPOKE[slug];
// The extracts page is titled by its post, not by the encyclical it quotes.
const postTitle =
  kind === 'extracts' ? ((await getPostBySlug(slug, 'es'))?.title ?? undefined) : undefined;
---

{
  kind === 'veritas' ? (
    <TopicVeritasPage lang="es" />
  ) : kind === 'extracts' ? (
    <DocumentDetail slug={EXTRACTS_DOCUMENT} lang="es" title={postTitle} />
  ) : (
    <PostDetail slug={slug} lang="es" />
  )
}
