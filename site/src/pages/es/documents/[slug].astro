---
import DocumentDetail from '../../../components/DocumentDetail.astro';
import { listPublishedDocuments } from '../../../lib/content';

// Spanish paths come from the SAME published set: where an 'es' locale row is missing the
// content helper falls back to English (Payload fallback: true), so every document gets a
// /es/ page even before a translation exists (Q2).
export async function getStaticPaths() {
  const docs = await listPublishedDocuments('es');
  return docs.map((d) => ({ params: { slug: d.slug }, props: { slug: d.slug } }));
}

const { slug } = Astro.props;
---

<DocumentDetail slug={slug} lang="es" />
