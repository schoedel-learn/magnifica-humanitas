---
import DocumentDetail from '../../components/DocumentDetail.astro';
import { listPublishedDocuments } from '../../lib/content';

// One static page per published document. getStaticPaths runs at build time against the
// database; if the DB is unreachable the build throws, which is deliberate.
export async function getStaticPaths() {
  const docs = await listPublishedDocuments('en');
  return docs.map((d) => ({ params: { slug: d.slug }, props: { slug: d.slug } }));
}

const { slug } = Astro.props;
---

<DocumentDetail slug={slug} lang="en" />
