---
// The posts route. Two of the three posts are bespoke layouts rather than CMS rich text —
// the Agentes Veritatis guide (three anchored steps) and the MH extracts (the quotations
// drawn out of the encyclical, a work in progress) — so the route picks its renderer by
// slug. This is the pattern the topic route already used for `truth`: the row lives in
// `posts`, so it lists, dates and types like any other post, while the page keeps the
// markup it was designed with.
import PostDetail from '../../components/PostDetail.astro';
import TopicVeritasPage from '../../components/TopicVeritasPage.astro';
import DocumentDetail from '../../components/DocumentDetail.astro';
import { getPostBySlug, listPublishedPosts } from '../../lib/content';
import { UI } from '../../lib/i18n';

const BESPOKE: Record<string, 'veritas' | 'extracts'> = {
  'agentes-veritatis': 'veritas',
  'magnifica-humanitas-in-quotations': 'extracts',
};
// The extracts page renders the MH document row, which is keyed by that row's own slug.
const EXTRACTS_DOCUMENT = 'magnifica-humanitas';

export async function getStaticPaths() {
  const posts = await listPublishedPosts('en');
  return posts.map((p) => ({ params: { slug: p.slug }, props: { slug: p.slug } }));
}

const { slug } = Astro.props;
const kind = BESPOKE[slug];
// The bespoke pages have no post row of their own, so the route fetches it once and hands
// them what they need: the title for the extracts page, and the by-line for both.
const postRow = kind ? await getPostBySlug(slug, 'en') : undefined;
const postTitle = kind === 'extracts' ? (postRow?.title ?? undefined) : undefined;
const byline = `${UI['en'].by} ${postRow?.authors?.trim() || UI['en'].publisher}`;
const affiliation = postRow?.affiliation?.trim() || undefined;
---

{
  kind === 'veritas' ? (
    <TopicVeritasPage lang="en" byline={byline} affiliation={affiliation} />
  ) : kind === 'extracts' ? (
    <DocumentDetail slug={EXTRACTS_DOCUMENT} lang="en" title={postTitle} byline={byline} affiliation={affiliation} />
  ) : (
    <PostDetail slug={slug} lang="en" />
  )
}
