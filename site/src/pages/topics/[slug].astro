---
import TopicPage from '../../components/TopicPage.astro';
import TopicVeritasPage from '../../components/TopicVeritasPage.astro';
import { listTopics } from '../../lib/content';

export async function getStaticPaths() {
  const topics = await listTopics('en');
  return topics.map((t) => ({ params: { slug: t.slug }, props: { slug: t.slug } }));
}

const { slug } = Astro.props;
---

{slug === 'truth' ? <TopicVeritasPage lang="en" /> : <TopicPage slug={slug} lang="en" />}